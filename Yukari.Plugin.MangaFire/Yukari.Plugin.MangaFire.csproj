<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <AssemblyName>Yukari.Plugin.MangaFire</AssemblyName>
    <RootNamespace>Yukari.Plugin.MangaFire</RootNamespace>

    <Version>1.2.0+core2.6.0</Version>
    <AssemblyVersion>1.2.0</AssemblyVersion>
    <AssemblyFileVersion>$(AssemblyVersion)</AssemblyFileVersion>
    <AssemblyInformationalVersion>$(Version)</AssemblyInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <AssemblyTitle>Yukari MangaFire Plugin</AssemblyTitle>
    <AssemblyProduct>Yukari</AssemblyProduct>
    <Description>MangaFire comic source plugin for Yukari.</Description>
    <Copyright>Copyright © TXG0Fk3. Licensed under GPL-3.0.</Copyright>
    <AssemblyCopyright>Copyright © TXG0Fk3. Licensed under GPL-3.0.</AssemblyCopyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yukari.Core" Version="2.6.0" />
  </ItemGroup>
</Project>
